# Example .env file — copy to .env and fill in your values
# DO NOT put real credentials here — this file IS committed to Git

# --- Supabase PostgreSQL Database ---
DB_HOST=your-project.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your-database-password
DB_SSL=require

# --- Spring Profile ---
SPRING_PROFILE=postgres

# --- Server ---
SERVER_PORT=8080
